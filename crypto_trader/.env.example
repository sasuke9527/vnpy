# Copy to .env (never commit .env). Loaded by crypto_trader/settings.py.
# ---- which venue the 50 USDT lives on: binance_linear | okx ----
CT_EXCHANGE=binance_linear
# ---- Binance USDT-M futures (create key with Futures trading enabled, NO withdrawal) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SERVER=REAL            # REAL | TESTNET
# ---- OKX (create key with Trade permission, NO withdrawal) ----
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_SERVER=REAL                # REAL | TEST (demo trading)
# ---- optional proxy for the live process ----
CT_PROXY_HOST=
CT_PROXY_PORT=0
# ---- risk dial: conservative | normal | aggressive ----
CT_RISK_DIAL=normal
CT_EQUITY_USDT=50
